        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{JSON.stringify({model:$env.LLM_MODEL||'gpt-4o-mini',messages:[{role:'system',content:'Analyze the research and return JSON: company_summary, person_summary, observable_pain_points, trigger_events, evidence_urls, recommended_outreach_angle, confidence.'},{role:'user',content:JSON.stringify({lead:$json,research:$json.results||$json})}],temperature:0.2})}}"
      },
