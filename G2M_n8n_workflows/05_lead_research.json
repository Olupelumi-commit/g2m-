    {
      "parameters": {
        "jsCode": "const raw=$json.choices?.[0]?.message?.content||$json.output||$json; let r; try{r=typeof raw==='string'?JSON.parse(raw.replace(/^```json\\s*|\\s*```$/g,'')):raw}catch(e){r={raw}} return [{json:{...$('Research Queries').first().json,research:r}}];"
      },
