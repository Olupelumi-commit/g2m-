      "parameters": {
        "jsCode": "const d=$json, icp=d.icp||{};\nlet score=0, reasons=[];\nconst size=Number(d.enrichment?.organization?.estimated_num_employees || d.employees || 0);\nif(size && (!icp.company_size_min || size>=icp.company_size_min) && (!icp.company_size_max || size<=icp.company_size_max)){score+=25;reasons.push('company size fit')}\nconst title=(d.title||'').toLowerCase();\nif((icp.target_titles||[]).some(t=>title.includes(String(t).toLowerCase()))){score+=25;reasons.push('role fit')}\nif((d.enrichment?.organization?.industry||d.industry) && (icp.industries||[]).some(x=>String(d.enrichment?.organization?.industry||d.industry).toLowerCase().includes(String(x).toLowerCase()))){score+=20;reasons.push('industry fit')}\nif(d.intent_signals?.length || d.signals?.length){score+=20;reasons.push('intent signals')}\nif(d.email){score+=10;reasons.push('contactable')}\nreturn [{json:{...d,qualification:{score,qualified:score>=75,reasons,scored_at:new Date().toISOString()}}}];"
      },
