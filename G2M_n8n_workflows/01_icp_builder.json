        "jsCode": "const raw = $json.choices?.[0]?.message?.content ?? $json.output ?? $json;\nlet parsed;\ntry { parsed = typeof raw === 'string' ? JSON.parse(raw.replace(/^```json\\s*|\\s*```$/g,'')) : raw; }\ncatch(e) { parsed = {parse_error:true, raw}; }\nreturn [{json:{...$('Normalize ICP Input').first().json, icp:parsed}}];"
      },
